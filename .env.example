# Copie para .env (cp .env.example .env), preencha e proteja: chmod 600 .env
# NUNCA faça commit do arquivo .env.

# ---------------- Aplicação
APP_NAME=Agente Técnico PU
APP_SHORT_NAME=Agente PU
# Gere com: openssl rand -base64 48   (sem isso as sessões caem a cada reinício)
SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA
SESSION_HOURS=12
COOKIE_SECURE=true
# Logins da rede (sAMAccountName) que viram administradores no primeiro acesso. Ex.: joao.silva,maria.souza
INITIAL_ADMINS=

# ---------------- Active Directory
LDAP_SERVER=10.1.1.205
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_TLS_VERIFY=false
LDAP_DOMAIN=flexivel.local
LDAP_BASE_DN=DC=flexivel,DC=local
LDAP_BIND_USER=integracao.ti@flexivel.local
LDAP_BIND_PASSWORD=COLOQUE_A_SENHA_AQUI_SOMENTE_NO_SERVIDOR
LDAP_TIMEOUT=8

# ---------------- Dify
DIFY_API_URL=https://dify.grupoflexivel.com.br/v1
# Os agentes (e as chaves de cada um) são cadastrados na tela Administração > Agentes.
# DIFY_API_KEY só é usada UMA vez, na primeira subida desta versão: a chave vira o primeiro agente
# e todos os usuários que já existiam continuam com acesso a ele. Numa instalação nova, pode ficar vazia.
DIFY_API_KEY=app-XXXXXXXXXXXXXXXXXXXXXXXX
DIFY_TIMEOUT=600
DIFY_VERIFY_TLS=true

# ---------------- Proteção do login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10
