# Copie para .env (cp .env.example .env), preencha e proteja: chmod 600 .env
# NUNCA faça commit do arquivo .env.

# ---------------- Aplicação
APP_NAME=Agente Técnico PU
APP_SHORT_NAME=Agente PU
# Gere com: openssl rand -base64 48   (sem isso as sessões caem a cada reinício)
SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA
SESSION_HOURS=12
COOKIE_SECURE=true
# Logins da rede (sAMAccountName) que viram administradores no primeiro acesso. Ex.: joao.silva,maria.souza
INITIAL_ADMINS=

# Porta publicada pelo docker compose. Padrão: 127.0.0.1:8090 (só a própria máquina; nginx local faz o HTTPS).
# Se o proxy HTTPS estiver em outra máquina, use APP_PORTA=8090 e libere no firewall só o IP do proxy.
# APP_PORTA=8090

# ---------------- Active Directory
LDAP_SERVER=10.1.1.205
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_TLS_VERIFY=false
LDAP_DOMAIN=flexivel.local
LDAP_BASE_DN=DC=flexivel,DC=local
LDAP_BIND_USER=integracao.ti@flexivel.local
LDAP_BIND_PASSWORD=COLOQUE_A_SENHA_AQUI_SOMENTE_NO_SERVIDOR
LDAP_TIMEOUT=8

# ---------------- Dify
DIFY_API_URL=https://dify.grupoflexivel.com.br/v1
# Os agentes (e as chaves de cada um) são cadastrados na tela Administração > Agentes.
# DIFY_API_KEY só é usada UMA vez, na primeira subida desta versão: a chave vira o primeiro agente
# e todos os usuários que já existiam continuam com acesso a ele. Numa instalação nova, pode ficar vazia.
DIFY_API_KEY=app-XXXXXXXXXXXXXXXXXXXXXXXX
DIFY_TIMEOUT=600
# Perguntas por áudio: tamanho máximo do arquivo (MB). O navegador grava até 5 min (~9,6 MB).
# O nginx precisa aceitar o mesmo tamanho: client_max_body_size 12m (veja deploy/nginx-agente.conf).
AUDIO_MAX_MB=12
DIFY_VERIFY_TLS=true

# ---------------- Envio de conhecimento com aprovação
# A chave de API de Conhecimento do Dify (dataset-...) normalmente é cadastrada na tela
# Administração > Agentes. Se preferir o .env, use a chave GERAL do workspace (Conhecimento > API).
DIFY_DATASET_API_KEY=
# Tamanho máximo do arquivo (MB). O Dify aceita 15 por padrão; o nginx precisa de client_max_body_size 16m.
CONHECIMENTO_MAX_MB=15
# Envios por pessoa por hora
CONHECIMENTO_ENVIOS_POR_HORA=30
# CONVERSOR_URL já vem do docker-compose.yml (http://conversor:8000); não precisa preencher.

# ---------------- Registros e exportação de conversas
# Fuso dos filtros por data e dos horários no TXT exportado
FUSO_HORARIO=America/Sao_Paulo
# Máximo de conversas num único arquivo TXT
EXPORTAR_MAX_CONVERSAS=1000

# ---------------- Proteção do login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10
